# The shared public edge for this host -- the one thing that owns :80/:443.
# Carries no domain-specific logic itself: every route lives in its own
# hand-written file under routes/. routes/incus-ui.caddy and routes/auth.caddy
# are this repo's own two built-in domains, pushed by deploy; add yours
# alongside them. (Routes used to be generated from config keys on the
# instances; that was removed -- see docs/removals/ingress-self-registration.md.)
#
# Automatic HTTPS (HTTP-01/TLS-ALPN-01) applies per-domain based on each
# route file's own site block — nothing to configure here for that.
#
# admin is NOT off, deliberately -- Caddy's default
# bind (127.0.0.1:2019, inside this container's own network namespace) is
# never exposed by anything in ingress.profile.yaml, so nothing on
# incusbr-ns can reach it. Only `incus exec ingress -- caddy reload ...`
# can, which is itself a host-privileged operation -- see DESIGN.md's
# "Apply" section for why that boundary is the same one this whole
# platform already trusts, not a new exposure.
{
	email {$ACME_EMAIL}
}

import /etc/caddy/routes/*.caddy
